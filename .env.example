# ============================================
# 🔧 MiFP — Variables de Entorno
# ============================================
# Copia este archivo como .env.local y rellena los valores.
# NUNCA commitees .env.local ni ningún archivo con valores reales.
#
# Requisitos mínimos para desarrollo local:
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Las variables marcadas como [OPCIONAL] no son necesarias para
# arrancar la app en desarrollo, pero algunas features no funcionarán sin ellas.

# ─────────────────────────────────────────────
# SUPABASE (obligatorio)
# ─────────────────────────────────────────────
# URL y anon key del proyecto Supabase.
# Se encuentran en: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — bypass de RLS. Solo server-side.
# Necesaria para: API admin, cron de notificaciones, audit logs.
# [OPCIONAL en dev si no usas funciones admin]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
# URL base de la app. En local se usa http://localhost:3000 por defecto.
# En producción: https://tu-dominio.com
# [OPCIONAL — default: http://localhost:3000]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# SEGURIDAD
# ─────────────────────────────────────────────
# Secret para firmar tokens CSRF (HMAC-SHA256).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [OBLIGATORIO para mutaciones protegidas con CSRF]
CSRF_SECRET=

# Secret para autenticar el cron job de notificaciones.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [OBLIGATORIO en producción]
CRON_SECRET=

# ─────────────────────────────────────────────
# UPSTASH REDIS (rate limiting)
# ─────────────────────────────────────────────
# Credenciales de Upstash Redis REST API.
# Se encuentran en: Upstash Console → tu base de datos → REST API
# [OPCIONAL en dev — rate limiting se desactiva sin ellas]
# [OBLIGATORIO en producción]
UPSTASH_REDIS_REST_URL=https://tu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AZw...

# ─────────────────────────────────────────────
# OPENAI (extracción de guías didácticas)
# ─────────────────────────────────────────────
# API key de OpenAI para extraer datos de PDFs con GPT.
# Se encuentra en: platform.openai.com → API Keys
# [OPCIONAL — solo necesaria para la feature de extracción de GDs]
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# CLOUDFLARE R2 (almacenamiento de recursos)
# ─────────────────────────────────────────────
# Credenciales de Cloudflare R2 para servir podcasts y PDFs.
# Se encuentran en: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# [OPCIONAL — solo necesarias para la feature de recursos/podcasts]
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# Nombres de los buckets (tienen defaults, solo cambiar si usas otros)
# [OPCIONAL — defaults: mifp-podcasts, mifp-pdfs]
CLOUDFLARE_R2_PODCASTS_BUCKET=mifp-podcasts
CLOUDFLARE_R2_PDFS_BUCKET=mifp-pdfs

# URLs públicas de los buckets R2 (con public access habilitado)
# [OPCIONAL — necesarias para servir archivos públicamente]
CLOUDFLARE_R2_PUBLIC_URL_PODCASTS=https://pub-xxx.r2.dev
CLOUDFLARE_R2_PUBLIC_URL_PDFS=https://pub-xxx.r2.dev

# ─────────────────────────────────────────────
# CLOUDFLARE TURNSTILE (CAPTCHA)
# ─────────────────────────────────────────────
# Site key pública para el widget de Turnstile en registro/login.
# Se encuentra en: Cloudflare Dashboard → Turnstile → tu widget
# Para testing local usa las keys de test de Cloudflare:
#   Site key: 1x00000000000000000000AA (siempre pasa)
# [OPCIONAL — sin ella los formularios no muestran CAPTCHA]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
